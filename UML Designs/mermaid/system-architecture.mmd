%% System Architecture Diagram — frontend, backend, realtime, DB, and external integrations
%%{init: {"themeVariables":{"clusterBkg":"#FAFAFA","fontFamily":"Inter, Arial"}}}%%
graph LR
  subgraph Frontend [Frontend (Next.js)]
    direction TB
    FE_pages["Pages & UI\n(client/src/app/*)"]:::frontend
    FE_ctx["AuthContext\nSocketContext"]:::frontend
    FE_hooks["useAuth\nuseProfile\nuseMessaging\nuseSearch"]:::frontend
    FE_pages --> FE_ctx
    FE_ctx --> FE_hooks
  end

  subgraph Backend [Backend (Express + TS)]
    direction TB
    API["REST API\nserver/src/index.ts\nroutes /api/v1/*"]:::backend
    MW["Middleware\nauthenticate, validate, rateLimiter, upload"]:::util
    Controllers["Controllers\n(server/src/modules/*/*.controller.ts)"]:::backend
    Services["Services\nAuth, Profile, Collaboration,\nMessaging, Search, Geocode"]:::service
    Repos["Repositories\nextend BaseRepository"]:::repo
    Models["Mongoose Models\nUser, Profile, CollaborationRequest,\nConversation, Message"]:::model
    EventBus["EventBus"]:::util
    AuthSvc["AuthService"]:::service
    GeoSvc["GeocodeService"]:::service
    API --> MW
    MW --> Controllers
    Controllers --> Services
    Services --> Repos
    Repos --> Models
    Services --> EventBus
    EventBus --> Services
    Services --> AuthSvc
    Services --> GeoSvc
  end

  subgraph RealTime [Real-time]
    SocketIO["Socket.io\n(server/src/config/socket.ts)"]:::service
    SocketIO <-- FE_ctx
    SocketIO --> Messaging["MessagingService (push events)"]
    Messaging --> EventBus
  end

  subgraph Data ["Database & Storage"]
    MongoDB["MongoDB (Atlas)\nMongoose models"]:::db
    Cloudinary["Cloudinary (media)"]:::external
    Nominatim["Nominatim (geocode)"]:::external
    SMTP["Nodemailer / SMTP"]:::external
  end

  FE_pages -->|HTTP / Axios (access token)| API
  API --> MongoDB
  Services --> Cloudinary
  GeoSvc --> Nominatim
  AuthSvc --> SMTP
  SocketIO --> MongoDB
  Messaging --> SocketIO

  classDef frontend fill:#E8F5E9,stroke:#4CAF50,color:#1B5E20;
  classDef backend fill:#E3F2FD,stroke:#2196F3,color:#0D47A1;
  classDef service fill:#E3F2FD,stroke:#2196F3,color:#0D47A1;
  classDef util fill:#F5F5F5,stroke:#9E9E9E,color:#424242;
  classDef repo fill:#E8F5E9,stroke:#4CAF50,color:#1B5E20;
  classDef model fill:#FFF8E1,stroke:#FFC107,color:#7A5A00;
  classDef db fill:#FFF8E1,stroke:#FFC107,color:#7A5A00;
  classDef external fill:#FFEBEE,stroke:#F44336,color:#B71C1C;
