%% Models (Mongoose)
class User {
  <<model>>
  ObjectId _id
  string username
  string email
  string role
  bool emailVerified
  bool isActive
}
class Profile {
  <<model>>
  ObjectId _id
  ObjectId userId
  string displayName
  string[] niche
  GeoJSON location
  number profileCompleteness
}
class CollaborationRequest {
  <<model>>
  ObjectId _id
  ObjectId userId
  ObjectId brandId
  string title
  string description
  number budget
  Date deadline
  string status
}
class Conversation {
  <<model>>
  ObjectId _id
  ObjectId[] participants
  ObjectId collaborationRequestId
}
class Message {
  <<model>>
  ObjectId _id
  ObjectId conversationId
  ObjectId senderId
  string content
  Date? readAt
}

