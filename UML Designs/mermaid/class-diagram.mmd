classDiagram
%% Styling classes
classDef backend fill:#eaf2ff,stroke:#0b5cff,color:#02285b;
classDef model fill:#fff7e6,stroke:#ff9844,color:#663f00;
classDef repo fill:#f0f7f0,stroke:#2e8b57,color:#0b5a3a;
classDef service fill:#eef7ff,stroke:#2f6fb2,color:#0b3a66;
classDef controller fill:#f7f7fb,stroke:#9aa7ff,color:#1b2a7a;
classDef util fill:#f5f5f5,stroke:#c0c0c0,color:#333;

%% Models (Mongoose)
class User {
  <<model>>
  ObjectId _id
  string username
  string? email
  string role
  bool emailVerified
  bool isActive
}
class Profile {
  <<model>>
  ObjectId _id
  ObjectId userId
  string displayName
  string[] niche
  GeoJSON location
  number profileCompleteness
}
class CollaborationRequest {
  <<model>>
  ObjectId _id
  ObjectId userId
  ObjectId brandId
  string title
  string description
  number budget
  Date deadline
  string status
}
class Conversation {
  <<model>>
  ObjectId _id
  ObjectId[] participants
  ObjectId collaborationRequestId
}
class Message {
  <<model>>
  ObjectId _id
  ObjectId conversationId
  ObjectId senderId
  string content
  Date? readAt
}

%% Repositories
class BaseRepository {
  +create()
  +findById()
  +find()
  +update()
}
class UserRepository
class ProfileRepository
class CollaborationRepository
class ConversationRepository
class MessageRepository

%% Services and utilities
class AuthService
class TokenService
class ProfileService
class CollaborationService
class MessagingService
class SearchService
class GeocodeService
class EventBus
class ResponseHelper

%% Controllers
class AuthController
class ProfileController
class CollaborationController
class MessagingController
class SearchController
class GeocodeController

%% Frontend contexts/hooks (logical classes)
class AuthContext
class SocketContext
class useProfile
class useMessaging

%% Visual grouping via notes
note left of BaseRepository
BaseRepository<T> used by feature repositories
end note

%% Inheritance & relationships
BaseRepository <|-- UserRepository : extends
BaseRepository <|-- ProfileRepository : extends
BaseRepository <|-- CollaborationRepository : extends
BaseRepository <|-- ConversationRepository : extends
BaseRepository <|-- MessageRepository : extends

UserRepository --> User : uses
ProfileRepository --> Profile : uses
CollaborationRepository --> CollaborationRequest : uses
ConversationRepository --> Conversation : uses
MessageRepository --> Message : uses

AuthService --> UserRepository : depends on
AuthController --> AuthService : uses

ProfileService --> ProfileRepository : depends on
ProfileController --> ProfileService : uses

CollaborationService --> CollaborationRepository : depends on
CollaborationController --> CollaborationService : uses
CollaborationService --> EventBus : emits events

MessagingService --> ConversationRepository : depends on
MessagingService --> MessageRepository : depends on
MessagingService --> EventBus : listens for COLLAB_ACCEPTED to create Conversation

SearchService --> ProfileRepository : depends on
GeocodeService --> external(Nominatim) : depends on

TokenService --> AuthService : issues/validates tokens
ResponseHelper ..> Controllers : used to normalize responses

AuthContext --> AuthService : frontend wrapper (calls APIs)
SocketContext --> MessagingService : open socket connection and forward events

%% Class styling
class User,Profile,CollaborationRequest,Conversation,Message model
class BaseRepository,UserRepository,ProfileRepository,CollaborationRepository,ConversationRepository,MessageRepository repo
class AuthService,ProfileService,CollaborationService,MessagingService,TokenService,SearchService,GeocodeService service
class AuthController,ProfileController,CollaborationController,MessagingController,SearchController,GeocodeController controller
class EventBus,ResponseHelper util
class AuthContext,SocketContext,useProfile,useMessaging backend
