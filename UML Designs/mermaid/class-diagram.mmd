classDiagram
    class AuthController {
        +register(req, res) Object
        +login(req, res) Object
        +sendEmailVerification(req, res) Object
        +verifyEmail(req, res) Object
        +refresh(req, res) Object
        +logout(req, res) Object
        +me(req, res) Object
    }

    class AuthService {
        -userRepo: UserRepository
        -tokenService: TokenService
        -emailProvider: EmailProvider
        +register(data) Object
        +login(username, password) Object
        +sendEmailVerification(userId) void
        +verifyEmail(token) Object
        +refreshTokens(refreshToken) Object
        +logout(userId) void
    }

    class TokenService {
        +generateAccessToken(payload) String
        +generateRefreshToken(payload) String
        +generateEmailToken(payload) String
        +verifyAccessToken(token) Payload
        +verifyRefreshToken(token) Payload
        +verifyEmailToken(token) Payload
    }

    class ProfileController {
        +createProfile(req, res) Object
        +getMyProfile(req, res) Object
        +updateMyProfile(req, res) Object
        +deleteMyProfile(req, res) Object
        +uploadAvatar(req, res) Object
        +uploadCover(req, res) Object
        +getProfileById(req, res) Object
    }

    class ProfileService {
        -profileRepo: ProfileRepository
        +createProfile(userId, data) Profile
        +getMyProfile(userId) Profile
        +updateProfile(userId, data) Profile
        +deleteProfile(userId) Boolean
        +uploadAvatar(userId, file) Profile
        +uploadCover(userId, file) Profile
        +getProfileById(id) Profile
        +calculateCompleteness(profile) Number
    }

    class SearchController {
        +searchProfiles(req, res) Object
        +searchCities(req, res) Object
    }

    class SearchService {
        -searchRepo: SearchRepository
        +searchProfiles(filters) List
        +searchCities(query) List
    }

    class GeocodeController {
        +search(req, res) Object
    }

    class GeocodeService {
        +search(query) List
    }

    class CollaborationController {
        +createRequest(req, res) Object
        +getInbox(req, res) Object
        +getSent(req, res) Object
        +acceptRequest(req, res) Object
        +declineRequest(req, res) Object
    }

    class CollaborationService {
        -collabRepo: CollaborationRepository
        +createRequest(brandId, data) CollaborationRequest
        +getInbox(userId, filters) Page
        +getSent(brandId, filters) Page
        +acceptRequest(requestId, userId) CollaborationRequest
        +declineRequest(requestId, userId) CollaborationRequest
    }

    class MessagingController {
        +listConversations(req, res) Object
        +getMessages(req, res) Object
        +sendMessage(req, res) Object
    }

    class MessagingService {
        -messagingRepo: MessagingRepository
        +listConversations(userId) List
        +getMessages(conversationId, userId) List
        +sendMessage(conversationId, senderId, content) Message
        +ensureConversation(participants, collabId) Conversation
        +subscribeToEvents(service) void
    }

    class BaseRepository~T~ {
        <<abstract>>
        #model: Model~T~
        +findById(id) T
        +findOne(filter) T
        +find(filter) List
        +create(data) T
        +updateById(id, data) T
        +deleteById(id) Boolean
    }

    class EventBus {
        <<singleton>>
        -listeners: Map
        +on(event, handler) void
        +emit(event, payload) void
    }

    class User {
        +_id: ObjectId
        +username: String
        +password: String
        +email: String
        +emailVerified: Boolean
        +role: UserRole
        +isActive: Boolean
        +isBanned: Boolean
        +refreshToken: String
        +createdAt: Date
        +updatedAt: Date
        +toJSON() Object
    }

    class Profile {
        +_id: ObjectId
        +userId: ObjectId
        +displayName: String
        +bio: String
        +avatar: String
        +coverImage: String
        +niche: String[]
        +interests: String[]
        +contentTypes: String[]
        +collaborationPreferences: Object
        +contactInfo: Object
        +location: GeoPoint
        +isVerified: Boolean
        +verifiedAt: Date
        +followerCount: Number
        +profileCompleteness: Number
    }

    class CollaborationRequest {
        +_id: ObjectId
        +userId: ObjectId
        +brandId: ObjectId
        +title: String
        +description: String
        +budget: Number
        +deadline: Date
        +status: RequestStatus
        +createdAt: Date
        +updatedAt: Date
    }

    class Conversation {
        +_id: ObjectId
        +participants: ObjectId[]
        +collaborationRequestId: ObjectId
        +lastMessageAt: Date
    }

    class Message {
        +_id: ObjectId
        +conversationId: ObjectId
        +senderId: ObjectId
        +content: String
        +readAt: Date
        +createdAt: Date
    }

    class UserRole {
        <<enumeration>>
        CREATOR
        BRAND
        ADMIN
    }

    class RequestStatus {
        <<enumeration>>
        OPEN
        PENDING
        ACCEPTED
        DECLINED
        CLOSED
    }

    AuthController --> AuthService
    AuthController --> TokenService
    AuthService --> TokenService
    AuthService --> EventBus : emits USER_REGISTERED, EMAIL_VERIFIED
    ProfileController --> ProfileService
    ProfileService --> Profile
    SearchController --> SearchService
    SearchService --> Profile
    GeocodeController --> GeocodeService
    CollaborationController --> CollaborationService
    CollaborationService --> CollaborationRequest
    CollaborationService --> EventBus : emits COLLAB_ACCEPTED
    MessagingController --> MessagingService
    MessagingService --> Conversation
    MessagingService --> EventBus : subscribes COLLAB_ACCEPTED
    Conversation "1" --> "*" Message
    User "1" --> "1" Profile
    User --> UserRole
    CollaborationRequest --> RequestStatus
    BaseRepository <|-- ProfileRepository
    BaseRepository <|-- CollaborationRepository
    BaseRepository <|-- MessagingRepository
    BaseRepository <|-- UserRepository
    BaseRepository <|-- SearchRepository
