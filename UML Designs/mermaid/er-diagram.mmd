%% ER Diagram — derived strictly from server/src/models/*.ts
%%{init: {"themeVariables":{"erPrimaryColor":"#4CAF50","erSecondaryColor":"#E3F2FD","erTextColor":"#1B1B1B","fontFamily":"Inter, Arial"}}}%%
erDiagram
    %% Entities and fields from server/src/models/*.ts

    USER {
      ObjectId _id PK
      string username
      string email
      string role
      bool emailVerified
      bool isActive
    }

    PROFILE {
      ObjectId _id PK
      ObjectId userId FK
      string displayName
      string[] niche
      GeoJSON location
      number profileCompleteness
    }

    COLLABORATIONREQUEST {
      ObjectId _id PK
      ObjectId userId FK  "creator"
      ObjectId brandId FK "brand"
      string title
      string description
      number budget
      Date deadline
      string status
    }

    CONVERSATION {
      ObjectId _id PK
      ObjectId[] participants FK(User)
      ObjectId collaborationRequestId FK(COLLABORATIONREQUEST) UNIQUE
      string lastMessage
    }

    MESSAGE {
      ObjectId _id PK
      ObjectId conversationId FK(CONVERSATION)
      ObjectId senderId FK(USER)
      string content
      Date? readAt
    }

    %% Relationships
    USER ||--o{ PROFILE : "1 to 1 (userId unique)"
    USER ||--o{ COLLABORATIONREQUEST : "brandId / userId (as participants)"
    COLLABORATIONREQUEST ||--o{ CONVERSATION : "1-to-1 (conversation.collaborationRequestId unique)"
    CONVERSATION ||--o{ MESSAGE : "1-to-many"
    USER ||--o{ MESSAGE : "1-to-many (sender)"
    CONVERSATION }o--|| USER : "participants (exactly 2)" 
