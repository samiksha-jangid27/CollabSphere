erDiagram
    USER ||--|| PROFILE : has
    USER {
        ObjectId _id
        string username
        string password
        string email
        boolean emailVerified
        string role
        boolean isActive
        boolean isBanned
        string refreshToken
        date createdAt
        date updatedAt
    }
    PROFILE {
        ObjectId _id
        ObjectId userId
        string displayName
        string bio
        string avatar
        string coverImage
        array niche
        array interests
        array contentTypes
        object collaborationPreferences
        object contactInfo
        object location
        boolean isVerified
        date verifiedAt
        number followerCount
        number profileCompleteness
    }

    USER ||--o{ COLLABORATION_REQUEST : sends_as_brand
    USER ||--o{ COLLABORATION_REQUEST : receives_as_creator
    COLLABORATION_REQUEST {
        ObjectId _id
        ObjectId userId
        ObjectId brandId
        string title
        string description
        number budget
        date deadline
        string status
        date createdAt
        date updatedAt
    }

    COLLABORATION_REQUEST ||--o| CONVERSATION : opens_on_accept
    USER }o--o{ CONVERSATION : participates
    CONVERSATION ||--o{ MESSAGE : contains
    CONVERSATION {
        ObjectId _id
        array participants
        ObjectId collaborationRequestId
        date lastMessageAt
    }
    MESSAGE {
        ObjectId _id
        ObjectId conversationId
        ObjectId senderId
        string content
        date readAt
        date createdAt
    }